# Copy to .dev.vars for local Cloudflare development only; do not commit secrets.
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ENV=development
# Choose gmail to send through the XPharma Gmail account.
MAIL_PROVIDER=gmail
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
RESEND_API_KEY=
RESEND_FROM=
NOTIFICATION_EMAIL=
INSTAPAY_ACCOUNT=
# Optional local home-page assistant. Never commit your actual Gemini key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
