# Copy to .env for local development; never commit real credentials.
DB_ENGINE=sqlite
SQLITE_DATABASE=data/xpharma_local.db
SECRET_KEY=replace-with-a-unique-random-secret

# Choose either SMTP or Resend for verification and order emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@example.com
NOTIFICATION_EMAIL=your-notification-email@example.com
RESEND_API_KEY=
RESEND_FROM=

INSTAPAY_ACCOUNT=your-instapay-account
