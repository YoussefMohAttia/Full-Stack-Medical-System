{
  "name": "xpharma",
  "version": "1.0.0",
  "description": "XPharma Express application on Cloudflare Workers",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "templates": "node cloudflare/scripts/compile-templates.cjs",
    "db:local": "wrangler d1 migrations apply xpharma-local --local",
    "dev:cloudflare": "wrangler dev",
    "test:api": "node --test cloudflare/flows.test.mjs cloudflare/prototype.test.mjs",
    "test:browser": "node --test cloudflare/browser.test.mjs",
    "test:smtp": "node --test cloudflare/smtp.test.mjs"
  },
  "type": "commonjs",
  "dependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/nunjucks": "^3.2.6",
    "bcryptjs": "^3.0.3",
    "cookie": "^0.7.2",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "nunjucks": "^3.2.4",
    "typescript": "^7.0.2",
    "wrangler": "^4.158.0"
  },
  "private": true,
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
