{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "@cloudflare/workers-types",
      "node"
    ],
    "noEmit": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "cloudflare/src/**/*.ts",
    "cloudflare/src/**/*.mts"
  ]
}