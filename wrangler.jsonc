{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "xpharma",
  "main": "cloudflare/src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "enable_nodejs_http_server_modules"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xpharma-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "assets": {
    "directory": "./static",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "PROOFS",
      "bucket_name": "xpharma-local-proofs"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "NOTIFICATION_EMAIL": "Xpharma25@gmail.com",
    "INSTAPAY_ACCOUNT": "mohamed.araby71@instapay"
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  }
}
